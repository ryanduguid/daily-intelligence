# Required
ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com — needs credit + web search enabled
RESEND_API_KEY=re_...               # resend.com — free tier is fine for personal use

# Email addresses (read by config.example.py; or hardcode them in your config.py)
FROM_EMAIL=digest@yourdomain.com    # must be a verified sender/domain in Resend
DIGEST_RECIPIENTS=you@example.com   # comma-separated
ALERT_RECIPIENTS=you@example.com    # failure alerts (defaults to DIGEST_RECIPIENTS)

# Optional
SQLITE_PATH=digest.db               # "already sent" dedup DB; use a persistent volume in prod
RUN_NOW=                            # set to 1 to run once immediately on boot (testing)
DIGEST_CONFIG_B64=                  # hosted deploys: base64 of your config.py instead of a file
